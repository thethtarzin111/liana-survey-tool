# Copy to .env and fill in. Never commit .env.
# Staging logins for Liana systems (lianacloud stg, LianaMailer testing,
# LianaMonitor staging) do NOT go here: keep them in your password manager.

# --- Postgres ---
POSTGRES_DB=survey
# Owns the schema. Used only for migrations and seed data.
POSTGRES_USER=survey_owner
POSTGRES_PASSWORD=change-me-owner
# Used by the services. Row-level security applies to this user.
APP_DB_USER=survey_app
APP_DB_PASSWORD=change-me-app

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=survey
RABBITMQ_DEFAULT_PASS=change-me-rabbit

# --- Answer links (#5, #42) ---
# Where readers open survey links (the gateway, which routes /r/ to the respondent service).
PUBLIC_BASE_URL=http://localhost:8000
# Signs each reader's answer link. Use a long random value outside local development;
# changing it makes links already sent stop working.
LINK_SIGNING_SECRET=change-me-link-secret
# LianaMailer placeholder for the contact id in newsletter snippet links (#40).
# Check the exact field with Liana before going live.
MAILER_READER_TAG=$id$

# --- "New responses" emails to survey owners ---
# Where the admin app runs; the emails link to its results page.
APP_BASE_URL=http://localhost:4200
# At most one email per survey per interval (e.g. 60 for a demo).
RESPONSE_DIGEST_INTERVAL_SECONDS=3600
# How often the worker checks for held responses.
RESPONSE_DIGEST_SWEEP_SECONDS=60

# --- Auth (no login screen yet: everyone is the demo user) ---
AUTH_MODE=dev
DEV_TENANT_ID=00000000-0000-4000-8000-000000000001
DEV_TENANT_NAME=Example Members Association
DEV_USER_ID=00000000-0000-4000-8000-000000000101
DEV_USER_NAME=Anna Virtanen
DEV_USER_EMAIL=anna.virtanen@example.org

# --- Liana connector ---
# mock = log events only. lianaautomation = call the real API (not built yet).
LIANA_ADAPTER=mock
LIANAAUTOMATION_BASE_URL=https://rest.automation.lianacloud.com/api/v1
LIANAAUTOMATION_CLIENT_ID=
LIANAAUTOMATION_CLIENT_SECRET=
# mock = log the "new responses" emails only (no real mail adapter yet).
NOTIFICATION_MAIL_ADAPTER=mock

# --- Comment insights (Results > Comment insights) ---
# mock = works offline. hdbscan = multilingual embeddings + HDBSCAN for 50+ comments
# (pip install -e "backend/services/data-analyzer[ai]").
INSIGHTS_GROUPER=mock
# mock only for now: no real LLM is connected yet (see docs/gdpr.md).
INSIGHTS_WRITER=mock
