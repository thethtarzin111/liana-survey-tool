# Copy to .env and fill in. Never commit .env.
# Staging logins for Liana systems (lianacloud stg, LianaMailer testing,
# LianaMonitor staging) do NOT go here: keep them in your password manager.

# --- Postgres ---
POSTGRES_DB=survey
# Owns the schema. Used only for migrations and seed data.
POSTGRES_USER=survey_owner
POSTGRES_PASSWORD=change-me-owner
# Used by the services. Row-level security applies to this user.
APP_DB_USER=survey_app
APP_DB_PASSWORD=change-me-app

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=survey
RABBITMQ_DEFAULT_PASS=change-me-rabbit

# --- Auth (no login screen yet: everyone is the demo user) ---
AUTH_MODE=dev
DEV_TENANT_ID=00000000-0000-4000-8000-000000000001
DEV_TENANT_NAME=Example Members Association
DEV_USER_ID=00000000-0000-4000-8000-000000000101
DEV_USER_NAME=Anna Virtanen
DEV_USER_EMAIL=anna.virtanen@example.org

# --- Liana connector ---
# mock = log events only. lianaautomation = call the real API (not built yet).
LIANA_ADAPTER=mock
LIANAAUTOMATION_BASE_URL=https://rest.automation.lianacloud.com/api/v1
LIANAAUTOMATION_CLIENT_ID=
LIANAAUTOMATION_CLIENT_SECRET=
