# API Gateway (report Figure 1): routing, authentication, rate limiting.
#
# The only way in from outside. Services sit on the internal Docker network.
# ${DEV_*} values are filled in from the environment when the container
# starts (nginx image envsubst, limited to DEV_ by NGINX_ENVSUBST_FILTER).
# nginx's own $variables are left alone.

# Rate limits per client IP. Respondents get more room: one office or mobile
# network can send many answers at once after a newsletter.
limit_req_zone $binary_remote_addr zone=admin:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=respondent:10m rate=50r/s;
limit_req_status 429;

server {
  listen 8000;
  client_max_body_size 1m;
  default_type application/json;

  # Identity headers are set per location below; they always overwrite
  # whatever the client sent. Common headers: snippets/proxy.conf.

  location = /health {
    return 200 '{"status":"ok","service":"gateway"}';
  }

  # Readiness of the system = the survey manager can reach the database.
  location = /health/ready {
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass http://survey-manager:8000/health/ready;
  }

  # --- Authentication ------------------------------------------------------
  # AUTH_MODE=dev: every admin request is the demo user from .env
  # (docs/decisions/0003). Liana's real login replaces this block: validate the
  # Liana session with auth_request and map its user into the same headers.
  location = /api/v1/me {
    limit_req zone=admin burst=40 nodelay;
    return 200 '{"user_id":"${DEV_USER_ID}","tenant_id":"${DEV_TENANT_ID}","tenant_name":"${DEV_TENANT_NAME}","name":"${DEV_USER_NAME}","email":"${DEV_USER_EMAIL}"}';
  }

  # --- Admin routes (signed-in user) ---------------------------------------
  location ~ ^/api/v1/(surveys|templates)(/|$) {
    limit_req zone=admin burst=40 nodelay;
    include /etc/nginx/snippets/proxy.conf;
    proxy_set_header X-Tenant-Id "${DEV_TENANT_ID}";
    proxy_set_header X-User-Id "${DEV_USER_ID}";
    proxy_set_header X-Tenant-Name "${DEV_TENANT_NAME}";
    proxy_set_header X-User-Name "${DEV_USER_NAME}";
    proxy_set_header X-User-Email "${DEV_USER_EMAIL}";
    proxy_pass http://survey-manager:8000;
  }

  location ~ ^/api/v1/results(/|$) {
    limit_req zone=admin burst=40 nodelay;
    include /etc/nginx/snippets/proxy.conf;
    proxy_set_header X-Tenant-Id "${DEV_TENANT_ID}";
    proxy_set_header X-User-Id "${DEV_USER_ID}";
    proxy_set_header X-Tenant-Name "${DEV_TENANT_NAME}";
    proxy_set_header X-User-Name "${DEV_USER_NAME}";
    proxy_set_header X-User-Email "${DEV_USER_EMAIL}";
    proxy_pass http://data-analyzer:8000;
  }

  # --- Public answer path (no login) --------------------------------------
  # Signed survey links: /r/<token>. Identity headers are cleared (an empty
  # value removes the header), so a respondent can never act as a user.
  location /r/ {
    limit_req zone=respondent burst=200 nodelay;
    include /etc/nginx/snippets/proxy.conf;
    proxy_set_header X-Tenant-Id "";
    proxy_set_header X-User-Id "";
    proxy_set_header X-Tenant-Name "";
    proxy_set_header X-User-Name "";
    proxy_set_header X-User-Email "";
    proxy_pass http://respondent:8000;
  }

  location / {
    return 404 '{"detail":"Not found"}';
  }
}
